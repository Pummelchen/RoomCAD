{
	auto_https disable_redirects

	# nginx terminates TLS in front of Caddy on this host. Unless Caddy is told
	# to trust it, Caddy overwrites X-Forwarded-Proto with its own (plain http)
	# scheme and replaces X-Forwarded-For with nginx's loopback address — so the
	# API can neither tell that the request arrived over HTTPS (and must mark
	# the session cookie Secure) nor tell one client from another for
	# rate-limiting. Trusting loopback preserves both.
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

:8090 {
	root * /var/xaios_updater
	header {
		X-Content-Type-Options nosniff
		Cache-Control "public, max-age=300"
	}
	file_server
}

:8077 {
	encode gzip
	header {
		-X-Frame-Options "DENY"
		-X-Content-Type-Options "nosniff"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8078 {
			flush_interval -1
		}
	}
	handle {
		root * /var/roomcad/web
		file_server
		header Cache-Control "no-cache"
	}
}

91.99.176.243:8443 {
	tls internal
	encode gzip
	header {
		-X-Frame-Options "DENY"
		-X-Content-Type-Options "nosniff"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8078 {
			flush_interval -1
		}
	}
	handle {
		root * /var/roomcad/web
		file_server
		header Cache-Control "no-cache"
	}
}
