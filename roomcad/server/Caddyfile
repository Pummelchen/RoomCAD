# RoomCAD's own web server.
#
# This is a PRIVATE Caddy instance: its own binary under /var/roomcad/bin, its
# own config here, its own storage under /var/roomcad/caddy, its own unix user
# and its own systemd unit (roomcad-caddy.service). It shares nothing with any
# other web server on the host.
#
# It listens on LOOPBACK ONLY. The host's master Caddy in /var/caddy owns ports
# 80 and 443, terminates TLS and routes this hostname here:
#
#   client ─443─> master (/var/caddy) ─> here (127.0.0.1:8081) ─> API (:8078)
#
# So this instance does no TLS at all. Certificates are the master's job, and
# because the master owns port 80 it answers the ACME challenge itself — no
# certbot, no store to borrow from, no hook to copy anything. The arrangement
# before this one borrowed a certificate out of certbot's store, which was a
# symlink into an unrelated project's tree; when that tree was restructured the
# link dangled and deploys began failing.
#
# RoomCAD's route into the master is the single file roomcad.caddy, installed
# into /var/caddy/sites/. No project edits another's routes.

{
	# Nothing here is reached from outside, so there is no TLS and no automatic
	# HTTPS to arrange. HTTP/3 is the master's business now — it is the server
	# clients actually connect to.
	auto_https off
	# This instance's own admin socket. Several Caddy processes run on this
	# host and they cannot share the default admin endpoint on 127.0.0.1:2019.
	admin unix//var/roomcad/caddy/admin.sock
}

# Loopback only: the master is the only way in, and binding this to a public
# interface would let someone reach the app around the TLS termination.
#
# The block matches ANY host, and binds to 127.0.0.1. It cannot be keyed on the
# public hostname: the master forwards the client's Host header unchanged, so a
# block keyed on an address would match nothing and Caddy would answer an empty
# 200 — a success with no body, and no error logged anywhere.
:8081 {
	bind 127.0.0.1
	encode gzip

	header {
		# In Caddy a leading "-" DELETES a header. These lines used to carry one,
		# so the app shipped with no clickjacking or MIME-sniffing protection.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		# Caddy terminates TLS here, so this host is only ever reached over
		# HTTPS. No includeSubDomains — it is one name under a shared wildcard
		# DNS service — and no preload, which cannot be undone in any useful
		# time frame.
		Strict-Transport-Security "max-age=31536000"
		# The import map in index.html is inline, so it is allowed by hash
		# rather than by unsafe-inline; tests/deploy-config.test.mjs checks that
		# the hash still matches the file. wasm-unsafe-eval is for the Rapier
		# physics engine and does NOT permit eval.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval' 'sha256-xuoopYrkZJxhGOUJm8Fz4reALjSXs2FHlvONCe4eFsw='"
	}

	handle /api/* {
		# Pass the ORIGINAL scheme through. Caddy sets X-Forwarded-Proto from
		# the connection it received, and the connection from the master is
		# plain HTTP over loopback — so left alone it would tell the API the
		# request arrived over HTTP, and the API would drop the Secure flag
		# from the session cookie. What matters is the scheme the user used,
		# which is what the master put in the header.
		#
		# Empty when nothing is in front (local development), in which case the
		# API falls back to judging by hostname, and loopback stays insecure.
		reverse_proxy 127.0.0.1:8078 {
			header_up X-Forwarded-Proto {header.X-Forwarded-Proto}
			flush_interval -1
		}
	}

	handle {
		root * /var/roomcad/web
		file_server
		# Revalidate every time, so a browser never keeps serving the previous
		# build of a module after a deploy.
		header Cache-Control "no-cache"
	}
}
