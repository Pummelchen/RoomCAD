# RoomCAD's own web server.
#
# This is a PRIVATE Caddy instance: its own binary under /var/roomcad/bin, its
# own config here, its own storage under /var/roomcad/caddy, its own unix user
# and its own systemd unit (roomcad-caddy.service). It shares nothing with any
# other web server on the host.
#
# It used to be a site block inside the system-wide /etc/caddy/Caddyfile, which
# also served an unrelated project on :8090 — so RoomCAD's deploy overwrote
# that project's configuration on every release, and that project's changes
# would have been lost on the next one. Two projects in one config file is one
# project's outage away from being the other project's problem.
#
# Nothing here reads a path belonging to anything else. In particular the
# certificate lives in /var/roomcad/tls, which is RoomCAD's own directory: the
# old arrangement copied it out of certbot's store through a hook, and when
# that store turned out to be a symlink into a third project's tree — a tree
# that was later restructured — the link dangled and deploys began failing.

{
	auto_https disable_redirects
	# This instance's own admin socket. Two Caddy processes cannot both hold
	# the default admin endpoint on 127.0.0.1:2019, and whichever started
	# second would fail.
	admin unix//var/roomcad/caddy/admin.sock
	servers {
		# HTTP/3 is on by default in this Caddy, but say so explicitly: it is a
		# property of the deployment we care about, and a default is a quiet
		# thing to lose on an upgrade. Caddy then listens on UDP as well as TCP
		# for every TLS site and advertises h3 via Alt-Svc.
		#
		# QUIC is UDP, and a firewall that allows TCP on a port does not allow
		# UDP on it — the two are separate rules. If HTTP/3 is not reachable
		# from outside while it works on the host itself, that is where to look;
		# deploy.sh checks and says so.
		protocols h1 h2 h3
	}
}

# The port is 8443 rather than 443 because an unrelated service already holds 80
# and 443 on this host. That also rules out Caddy running ACME for itself —
# HTTP-01 needs port 80 and TLS-ALPN-01 needs port 443 — so it serves a
# certificate kept in RoomCAD's own directory (see renew-certificate.sh).
roomcad.91.99.176.243.nip.io:8443 {
	tls /var/roomcad/tls/fullchain.pem /var/roomcad/tls/privkey.pem
	encode gzip

	header {
		# In Caddy a leading "-" DELETES a header. These lines used to carry one,
		# so the app shipped with no clickjacking or MIME-sniffing protection.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		# Caddy terminates TLS here, so this host is only ever reached over
		# HTTPS. No includeSubDomains — it is one name under a shared wildcard
		# DNS service — and no preload, which cannot be undone in any useful
		# time frame.
		Strict-Transport-Security "max-age=31536000"
		# The import map in index.html is inline, so it is allowed by hash
		# rather than by unsafe-inline; tests/deploy-config.test.mjs checks that
		# the hash still matches the file. wasm-unsafe-eval is for the Rapier
		# physics engine and does NOT permit eval.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval' 'sha256-xuoopYrkZJxhGOUJm8Fz4reALjSXs2FHlvONCe4eFsw='"
	}

	handle /api/* {
		# No X-Forwarded-* overrides here, deliberately. They existed to stop
		# Caddy replacing nginx's view of the request. With nothing in front,
		# Caddy's own values ARE the truth, and copying a header that is no
		# longer sent would tell the API the request arrived over plain HTTP and
		# drop the Secure flag from the session cookie.
		reverse_proxy 127.0.0.1:8078 {
			flush_interval -1
		}
	}

	handle {
		root * /var/roomcad/web
		file_server
		# Revalidate every time, so a browser never keeps serving the previous
		# build of a module after a deploy.
		header Cache-Control "no-cache"
	}
}
