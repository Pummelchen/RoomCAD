{
	auto_https disable_redirects
}

:8090 {
	root * /var/xaios_updater
	header {
		X-Content-Type-Options nosniff
		Cache-Control "public, max-age=300"
	}
	file_server
}

:8077 {
	encode gzip
	header {
		# In Caddy a leading "-" DELETES a header. These lines used to carry
		# it, so the app shipped with no clickjacking or MIME-sniffing
		# protection at all — and nginx in front adds none either.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8078 {
			flush_interval -1
			# nginx terminates TLS in front of this site. Caddy would otherwise
			# replace both of these with its own view — X-Forwarded-Proto with
			# plain "http", and X-Forwarded-For with nginx's loopback address —
			# leaving the API unable to tell that the request reached the user
			# over HTTPS, or to tell one client from another for rate limiting.
			# Passing nginx's values through keeps the real client LAST in
			# X-Forwarded-For: the entry nginx itself appended, which a client
			# cannot forge. (trusted_proxies would be tidier but needs Caddy 2.7;
			# this host runs 2.6.2.)
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
		}
	}
	handle {
		root * /var/roomcad/web
		file_server
		header Cache-Control "no-cache"
	}
}

91.99.176.243:8443 {
	tls internal
	encode gzip
	header {
		# In Caddy a leading "-" DELETES a header. These lines used to carry
		# it, so the app shipped with no clickjacking or MIME-sniffing
		# protection at all — and nginx in front adds none either.
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8078 {
			flush_interval -1
		}
	}
	handle {
		root * /var/roomcad/web
		file_server
		header Cache-Control "no-cache"
	}
}
