# RoomCAD web — local Caddy server
# Start with: ./serve.sh   (or: ./bin/caddy run --config Caddyfile)
#
# Proxies /api/* to the Python backend on 127.0.0.1:8078 so save/load and live
# collaboration work locally. Start the backend first, e.g.:
#   ROOMCAD_DB_PATH=/tmp/roomcad.db ROOMCAD_PASSWORD=ternak \
#     python3 ../server/server.py

:8080 {
	handle /api/* {
		reverse_proxy 127.0.0.1:8078 {
			flush_interval -1
		}
	}
	handle {
		root * .
		file_server
		encode gzip
		header {
			# Match production. A leading "-" would DELETE these rather than
			# set them, which is what the deployed config used to do.
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "same-origin"
			# The import map is inline, so it is allowed by hash rather than by
			# unsafe-inline; the hash is checked against index.html by
			# tests/deploy-config.test.mjs. wasm-unsafe-eval is for the Rapier
			# physics engine, which instantiates WebAssembly.
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval' 'sha256-xuoopYrkZJxhGOUJm8Fz4reALjSXs2FHlvONCe4eFsw='"
			# Match production: revalidate every time. Without this the browser
			# applies heuristic freshness and quietly keeps serving the previous
			# build of a module after you have edited it.
			Cache-Control "no-cache"
		}
	}
}
